{
  "name": "@adobe/aem-docs",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "AEM documentation site and its generated API reference",
  "scripts": {
    "preview:api": "node scripts/docs/preview-api.mjs",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"blocks/**/*.css\" \"styles/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "test": "node --test test/docs/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/aem-docs.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "engines": {
    "node": "^26.0.0"
  },
  "bugs": {
    "url": "https://github.com/adobe/aem-docs/issues"
  },
  "homepage": "https://github.com/adobe/aem-docs#readme",
  "devDependencies": {
    "@babel/eslint-parser": "7.29.13",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "linkedom": "0.18.14",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
