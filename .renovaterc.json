{
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "labels": ["ignore-psi-check"],
      "automerge": true,
      "ignoreTests": false
    },
    {
      "matchPackageNames": ["eslint"],
      "allowedVersions": "^8.0.0",
      "description": "Pin ESLint to v8 until airbnb-base supports v9+"
    },
    {
      "matchPackageNames": ["@babel/eslint-parser"],
      "allowedVersions": "^7.0.0",
      "description": "@babel/eslint-parser v8 requires ESLint 9+; keep v7 while ESLint is pinned to v8"
    }
  ]
}